{
  "name": "bird-alert",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@vercel/analytics": "^2.0.1",
    "i18next": "26.5.2",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "17.1.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.1",
    "react-toastify": "^11.2.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "cypress run --browser electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webkit": "playwright test",
    "slides": "node marketing/render.mjs",
    "slides:check": "eslint marketing && tsc -p marketing/tsconfig.json",
    "test:offline": "vite build && playwright test -c playwright.offline.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "cypress": "^15.0.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-cypress": "^7.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
